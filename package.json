{
  "name": "lfps-substitutions-suite",
  "version": "2.0.0-alpha.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@lfps/web",
    "build:web": "npm run build --workspace=@lfps/web",
    "build:core": "npm run build --workspace=@lfps/core",
    "test:core": "npm test --workspace=@lfps/core",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

